NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATA_FILE=./data/state.json

# Development-only user token
DEV_USER_TOKEN=change-me-user

# WebSocket development token
WS_TOKEN=change-me-ws

# Agent/monitor shared tokens for MVP.
# Production: replace with per-agent credentials.
AGENT_SHARED_TOKEN=change-me-agent
MONITOR_TOKEN=change-me-monitor

# Firebase Admin (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Default alert thresholds
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_COOLDOWN_SECONDS=300
